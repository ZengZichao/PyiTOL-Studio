{
  "_meta": {
    "name": "pyitol-studio parameter catalog",
    "provenance": "Parameter keys bootstrapped from the 44 official iTOL v7 templates (PyiTOL-参考文件/iTOL-v7-模板文件) via pyitol learner; ranges/defaults curated per iTOL help page. scripts/rda_to_json.py can regenerate raw ranges from itol.toolkit data/*.rda.",
    "note": "Fields missing here fall back to generic text editing (development plan R7). Lists are space-separated single-line values, matching iTOL template syntax.",
    "version": 1
  },
